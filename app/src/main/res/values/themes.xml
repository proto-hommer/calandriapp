<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Oscuro desde el arranque: sin fogonazo blanco antes de que cargue Compose. -->
    <style name="Theme.MeshPaper" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hud_bg</item>
        <item name="android:colorBackground">@color/hud_bg</item>
    </style>

    <!-- Pantalla de inicio (androidx core-splashscreen: igual en Android 8 a 16).
         Solo el fondo azul marino: enseguida sigue la intro animada, que arma la calandria. -->
    <style name="Theme.CalandriApp.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/intro_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_vacio</item>
        <item name="postSplashScreenTheme">@style/Theme.MeshPaper</item>
    </style>
</resources>
